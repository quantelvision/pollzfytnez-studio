# Copy to .env.local and fill in. The site builds and runs without any of these:
# media slots render labelled placeholders until Cloudinary is configured.

# Public site origin, used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.pollzfytnezgym.in

# Cloudinary cloud name (Dashboard > Settings > Account). Needed to build any media URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary Admin API credentials (Dashboard > Settings > Access keys).
# Server-only: used to fetch contextual metadata (alt, caption) stored on assets.
# Never expose these with a NEXT_PUBLIC_ prefix.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form delivery. Without these the form tells visitors to use WhatsApp
# instead of silently failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=
# Envelope sender. Falls back to SMTP_USER when unset.
CONTACT_FROM_EMAIL=

# How many gallery tiles show before the see-all control. Defaults to 10.
GALLERY_PREVIEW_COUNT=10

# Google Search Console ownership token, the content value of the meta tag it
# gives you. Optional: without it the verification tag is simply not rendered.
GOOGLE_SITE_VERIFICATION=

# Shared secret for POST /api/revalidate, which drops the cached Cloudinary
# lookups so a newly uploaded photo or video appears without waiting the hour
# or redeploying. Any long random string. Without it the endpoint is disabled.
REVALIDATE_SECRET=
