# Copy to .env.local and fill in. The site builds and runs without any of these:
# media slots render labelled placeholders until Cloudinary is configured.

# Public site origin, used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.pollzfytnezgym.in

# Cloudinary cloud name (Dashboard > Settings > Account). Needed to build any media URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary Admin API credentials (Dashboard > Settings > Access keys).
# Server-only: used to fetch contextual metadata (alt, caption) stored on assets.
# Never expose these with a NEXT_PUBLIC_ prefix.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form delivery, through Resend. Without these the form tells visitors
# to use WhatsApp instead of silently failing.
# API key from the Resend dashboard, Settings > API Keys.
RESEND_API_KEY=
# Who the enquiry is sent from. This is a From address, not a mailbox: nothing
# is ever received here, so it does not have to exist as an inbox. Resend only
# accepts an address on a domain verified in its dashboard, so once
# pollzfytnezgym.in is verified this becomes noreply@pollzfytnezgym.in.
#
# onboarding@resend.dev is Resend's shared test sender. It needs no DNS but only
# delivers to the address the Resend account was opened with, so it cannot be
# used to reach the gym's inbox. It is a stopgap, not a launch setting.
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Where enquiries are delivered. This is the gym's real inbox, and it is the one
# address that has to be a working mailbox. While the sender above is still
# onboarding@resend.dev this has to be the address the Resend account was opened
# with, because that is the only place the test sender can deliver.
CONTACT_TO_EMAIL=

# How many gallery tiles show before the see-all control. Defaults to 10.
GALLERY_PREVIEW_COUNT=10

# Google Search Console ownership token, the content value of the meta tag it
# gives you. Optional: without it the verification tag is simply not rendered.
GOOGLE_SITE_VERIFICATION=
